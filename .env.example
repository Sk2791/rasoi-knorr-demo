# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fallback text-generation provider, used automatically
# whenever Gemini is unset or every attempt fails (e.g. free-tier quota).
GROQ_API_KEY="MY_GROQ_API_KEY"

# XAI_API_KEY: Optional. When set, each generated banner gets a real
# AI-generated (xAI Grok) background photo instead of the bundled stock
# photos, grounded in that card's actual city/flavor. Costs a small per-image
# fee on generation (not on every view — images are generated once and
# stored). Safe to leave unset: cards simply fall back to the stock pool.
XAI_API_KEY="MY_XAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
